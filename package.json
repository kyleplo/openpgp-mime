{
  "name": "openpgp-mime",
  "version": "1.0.2",
  "description": "Email parsing library based upon postal-mime but with added support for PGP encrypted and signed emails as specified in RFC 3156",
  "license": "LGPL-3.0-or-later",
  "author": "kyleplo",
  "type": "module",
  "scripts": {
    "prepublishOnly": "npm run compile",
    "test": "npx tsx --test",
    "compile": "npm run clean && tsc -p .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "openpgp": "^6.3.0",
    "postal-mime": "^2.7.4"
  },
  "devDependencies": {
    "@types/libqp": "^1.1.3",
    "@types/node": "^25.9.1",
    "libqp": "^2.1.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "openpgp",
    "mime"
  ],
  "bugs": {
    "url": "http://github.com/kyleplo/openpgp-mime/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kyleplo/openpgp-mime.git"
  },
  "files": [
    "dist"
  ]
}
